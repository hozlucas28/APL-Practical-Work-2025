#!/bin/bash

#Configuramos los parametros de entrada

#Parametro Corto
pMatrizNombreCorto="m"
pHubNombreCorto="u"
pCaminoNombreCorto="c"
pSeparadorNombreCorto="s"

#Parametro Largo
pMatrizNombre="matriz"
pHubNombre="hub"
pCaminoNombre="camino"
pSeparadorNombre="separador"

##Otras Variables.

archivo_matriz=""
parametros=""
separador=""
help=false
hub=false
camino=false

declare -A matriz_Mapa
filas=0

##Codigo
##Tratamiento de parametros de entrada

parametros=$(getopt -o "h$pMatrizNombreCorto:$pHubNombreCorto$pCaminoNombreCorto$pSeparadorNombreCorto:" --long "help,$pMatrizNombre:,$pHubNombre,$pCaminoNombre,$pSeparadorNombre:" -- "$@")

if [ $? -ne 0 ]; then
    echo "No se pudieron procesar los parametros de entrada" >&2
    exit 1
fi

eval set -- "$parametros"

while true; do
    case "$1" in
      "-h" | "--help")
        help=true
        shift 1
        break
        ;;
      "-$pMatrizNombreCorto" | "--$pMatrizNombre")
        archivo_matriz="$2"
        shift 2
        ;;
      "-$pHubNombreCorto" | "--$pHubNombre")
        hub=true
        shift 1
        ;;
      "-$pCaminoNombreCorto" | "--$pCaminoNombre")
        camino=true
        shift 1
        ;;
      "-$pSeparadorNombreCorto" | "--$pSeparadorNombre")
        separador="$2"
        shift 2
        ;;
      "--")
        shift
        break
        ;;
      *)
        echo "> Se produjo un error al analizar las opciones" >&2
        exit 1
        ;;
    esac
done

# Mostrar ayuda 
if [ "$help" = true ]; then
    printf "Uso: $0 [OPCIONES...]\

    -h, --help                    Muestra esta lista de ayuda\ 
    -m, --matriz ARCHIVO          Especifica el archivo de matriz\
    -u, --hub                     Calcula el hub de la red\
    -c, --camino                  Calcula el camino más corto\
    -s, --separador SEPARADOR     Especifica el separador\

    Las opciones \`-u\` / \`--hub\` y \`-c\` / \`--camino\` no deben declararse juntas.
    "
    exit 0
fi

##Verificamos archivo matriz

if [ -z "$archivo_matriz" ]; then
  echo "> La opción \`-$pMatrizNombreCorto\` / \`--$pMatrizNombre\` es requerida" >&2
  exit 1
fi

if [ ! -f "$archivo_matriz" ]; then
  echo "> La opción \`-$pMatrizNombreCorto\` / \`--$pMatrizNombre\` debe ser un archivo válido" >&2
  exit 1
fi

##Verificamos Separador
if [ -z "$separador" ]; then
  echo "> La opción \`-$pSeparadorNombreCorto\` / \`--$pSeparadorNombre\` es requerida" >&2
  exit 1
fi

if [ ${#separador} -ne 1 ]; then
  echo "> La opción \`-$pSeparadorNombreCorto\` / \`--$pSeparadorNombre\` requiere un caracter de separacion" >&2
  exit 1
fi

##Verificamos hub y camino
if [ "$hub" != "true" ] && [ "$camino" != "true" ]; then
  echo "> Las opciones \`-$pHubNombreCorto\` / \`--$pHubNombre\` ó \`-$pCaminoNombreCorto\` / \`--$pCaminoNombre\` son requeridas" >&2
  exit 1
fi

if [ "$hub" = "true" ] && [ "$camino" = "true" ]; then
  echo "> \`-$pHubNombreCorto\` / \`--$pHubNombre\` y \`-$pCaminoNombreCorto\` / \`--$pCaminoNombre\` no deben declararse juntas" >&2
  exit 1
fi

##Validar Numero
validar_numero() {
    local valor="$1"
  
    if [[ "$valor" =~ ^[0-9]+$ ]] || [[ "$valor" =~ ^[0-9]+\.[0-9]+$ ]]; then
        return 0 
    else
        return 1 
    fi
}

##Funcion Leer Matriz
leer_matrizNumerica() {
    local archivo="$1"
    local separador="$2"
    local -n matriz=$3  #la matriz en modo -n (alias o puntero a la global)
    local fila=0
    
    while IFS= read -r linea; do
        # Saltamos las lineas vacias
        [[ -z "$linea" ]] && continue
        # Usamos el Separador
        IFS="$separador" read -ra valores <<< "$linea" #Modo -ra raw(-r) array (-a)
        
        # Guardamos la fila en la variable fila
        for i in "${!valores[@]}"; do
          if ! validar_numero "${valores[$i]}"; then
            echo "> Error: '${valores[$i]}' no es un número válido en posición [$fila,$i]" >&2
            return 1
          fi
          matriz[$fila,$i]="${valores[$i]}"
        done

        ((fila++))
    done < "$archivo" # leemos desde archivo
    echo $fila  # retornamos las filas
}
##Funcion para chequear si es cuadrada
verificar_matriz_cuadrada() {
    local -n matriz=$1
    local filas=$2
    
    # Contar columnas de la primera fila
    local columnas=0
    for ((j=0; ; j++)); do
        if [[ -n "${matriz[0,$j]:-}" ]]; then
            ((columnas++))
        else
            break
        fi
    done
    
    # Verificar que filas = columnas
    if [ $filas -ne $columnas ]; then
        return 1
    fi
    
    # Verificar que todas las filas tengan el mismo número de columnas
    for ((i=0; i<filas; i++)); do
        local columnas_fila=0
        for ((j=0; ; j++)); do
            if [[ -n "${matriz[$i,$j]:-}" ]]; then
                ((columnas_fila++))
            else
                break
            fi
        done
        
        if [ $columnas_fila -ne $columnas ]; then
            return 1
        fi
    done
    
    return 0
}

#Funcion para Chequear que la diagonal tenga ceros
check_diagonal_con_ceros() {
    local -n matriz=$1
    local filas=$2

    for ((i=0; i<filas; i++)); do
        if [[ "${matriz[$i,$i]}" != "0" && "${matriz[$i,$i]}" != "0.0" ]]; then
            return 1
        fi
    done
    
    return 0
}

#Funcion para Chequear que sea simetrica
check_matriz_simetrica() {
    local -n matriz=$1
    local filas=$2

    for ((i=0; i<filas; i++)); do
        for ((j=0; j<filas; j++)); do
            if [[ "${matriz[$i,$j]}" != "${matriz[$j,$i]}" ]]; then
                return 1
            fi
        done
    done
    return 0
}

##Funciones Principales

##Funcion para obtener el hub (estacion con mas conexiones)
get_hub() {
    local -n matriz=$1
    local filas=$2
    
    local conexiones_max=-1
    local estacion_hub=-1
    local cont=1

    for ((i=0; i<filas; i++)); do
        local conexiones=0
        
        # Contar conexiones en la fila (valores > 0)
        for ((j=0; j<filas; j++)); do
            if [[ -n "${matriz[$i,$j]}" ]]; then
                # Verificar si el valor es mayor que 0
                if (( $(echo "${matriz[$i,$j]} > 0" | bc -l) )); then
                    ((conexiones++))
                fi
            fi
        done
        # Si encontramos más conexiones, actualizar el hub
        if [ $conexiones -gt $conexiones_max ]; then
            conexiones_max=$conexiones
            estacion_hub=$cont
        fi
        
        ((cont++))
    done
    echo "$estacion_hub $conexiones_max"
}

#Funcion de Camino mas Corto
get_camino_mas_corto() {
    local -n matriz=$1
    local n=$2
    local -A distancias
    local -a resultados
    
    # Inicializar matriz de distancias con Floyd-Warshall
    for ((i=0; i<n; i++)); do
        for ((j=0; j<n; j++)); do
            if [ $i -eq $j ]; then
                distancias[$i,$j]=0
            elif (( $(echo "${matriz[$i,$j]} > 0" | bc -l) )); then
                distancias[$i,$j]="${matriz[$i,$j]}"
            else
                distancias[$i,$j]=999999  # Representar infinito
            fi
        done
    done
    
    # Algoritmo Floyd-Warshall
    for ((k=0; k<n; k++)); do
        for ((i=0; i<n; i++)); do
            for ((j=0; j<n; j++)); do
                local dist_ik="${distancias[$i,$k]}"
                local dist_kj="${distancias[$k,$j]}"
                local dist_ij="${distancias[$i,$j]}"
                
                if [ "$dist_ik" != "999999" ] && [ "$dist_kj" != "999999" ]; then
                    local nueva_dist=$(echo "$dist_ik + $dist_kj" | bc -l)
                    if (( $(echo "$nueva_dist < $dist_ij" | bc -l) )); then
                        distancias[$i,$j]="$nueva_dist"
                    fi
                fi
            done
        done
    done
    
    # Calcular para cada punto de inicio usando algoritmo voraz
    for ((inicio=0; inicio<n; inicio++)); do
        local -a visitados
        local actual=$inicio
        local tiempo_total=0
        local ruta="$((inicio + 1))"
        
        # Inicializar array de visitados
        for ((v=0; v<n; v++)); do
            visitados[$v]=false
        done
        visitados[$inicio]=true
        
        # Algoritmo voraz: siempre ir al nodo más cercano no visitado
        for ((paso=1; paso<n; paso++)); do
            local menor_distancia=999999
            local siguiente_nodo=-1
            
            # Buscar el nodo más cercano no visitado
            for ((j=0; j<n; j++)); do
                if [ "${visitados[$j]}" = "false" ]; then
                    local dist_actual="${distancias[$actual,$j]}"
                    if (( $(echo "$dist_actual < $menor_distancia" | bc -l) )); then
                        menor_distancia="$dist_actual"
                        siguiente_nodo=$j
                    fi
                fi
            done
            
            # Si no hay nodo alcanzable, marcar como infinito
            if [ $siguiente_nodo -eq -1 ]; then
                tiempo_total=999999
                break
            fi
            
            # Moverse al siguiente nodo
            tiempo_total=$(echo "$tiempo_total + $menor_distancia" | bc -l)
            visitados[$siguiente_nodo]=true
            ruta="$ruta -> $((siguiente_nodo + 1))"
            actual=$siguiente_nodo
        done
        
        # Guardar resultado (formato: "estacion_inicio|tiempo_total|ruta")
        echo "$((inicio + 1))|$tiempo_total|$ruta"
    done
}



# Principal
filas=$(leer_matrizNumerica "$archivo_matriz" "$separador" matriz_Mapa)
if [ $? -ne 0 ]; then
    echo "> Archivo contiene valores no numéricos" >&2
    exit 1
fi

if ! verificar_matriz_cuadrada matriz_Mapa $filas; then
    echo "> La matriz no cumple los requisitos" >&2
    exit 1
fi

if ! check_diagonal_con_ceros matriz_Mapa $filas; then
    echo "> La matriz no tiene diagonal con ceros" >&2
    exit 1
fi

if ! check_matriz_simetrica matriz_Mapa $filas; then
    echo "> La matriz no es simétrica" >&2
    exit 1
fi

if [ "$hub" = "true" ]; then

    resultado_hub=$(get_hub matriz_Mapa $filas)
    read -r estacion_hub conexiones_max <<< "$resultado_hub"
    informe_res="**Hub de la red:** Estación $estacion_hub ($conexiones_max conexiones)"
    
elif [ "$camino" = "true" ]; then
    resultados_raw=$(get_camino_mas_corto matriz_Mapa $filas)
    
    # Convertir a arrays paralelos
    declare -a estaciones_inicio
    declare -a tiempos_totales  
    declare -a rutas
    contador=0
    
    while IFS='|' read -r estacion tiempo ruta; do
        estaciones_inicio[$contador]="$estacion"
        tiempos_totales[$contador]="$tiempo"
        rutas[$contador]="$ruta"
        ((contador++))
    done <<< "$resultados_raw"
    
    if [ $contador -eq 0 ]; then
        informe_res="**Estado:** No es posible visitar todas las estaciones desde ningún punto de partida"
    else
        # Encontrar el tiempo mínimo global
        tiempo_minimo="${tiempos_totales[0]}"
        for ((i=1; i<contador; i++)); do
            if (( $(echo "${tiempos_totales[$i]} < $tiempo_minimo" | bc -l) )); then
                tiempo_minimo="${tiempos_totales[$i]}"
            fi
        done
        # Filtrar solo las estaciones que tengan el tiempo mínimo
        declare -a mejores_estaciones
        declare -a mejores_rutas
        mejores_contador=0
        
        for ((i=0; i<contador; i++)); do
            if (( $(echo "${tiempos_totales[$i]} == $tiempo_minimo" | bc -l) )); then
                mejores_estaciones[$mejores_contador]="${estaciones_inicio[$i]}"
                mejores_rutas[$mejores_contador]="${rutas[$i]}"
                ((mejores_contador++))
            fi
        done
        
        if [ $mejores_contador -eq 1 ]; then
            # Solo un resultado óptimo
            informe_res="**Camino más corto visitando todas las estaciones:**
**Estación de inicio:** Estación ${mejores_estaciones[0]}
**Tiempo total:** $tiempo_minimo minutos
**Ruta completa:** ${mejores_rutas[0]}"
        else
            # Múltiples resultados óptimos
            informe_res="**Caminos más cortos visitando todas las estaciones (tiempo: $tiempo_minimo minutos):**"
            
            for ((i=0; i<mejores_contador; i++)); do
                informe_res="$informe_res

**Estación de inicio:** Estación ${mejores_estaciones[$i]}
**Tiempo total:** $tiempo_minimo minutos
**Ruta completa:** ${mejores_rutas[$i]}"
            done
        fi
      fi
  fi
    

texto_final="## Informe de análisis de red de transporte
$informe_res"
directorio_matriz=$(dirname "$archivo_matriz")
nombre_archivo=$(basename "$archivo_matriz")

# Generamos el archivo
direccion_final="$directorio_matriz/informe.$nombre_archivo"

echo "$texto_final" > "$direccion_final"
echo "> Informe generado en: $direccion_final"










